# Copy to .env (gitignored). Never commit the real host or remote file path.

# Full scp spec — same user@host:/path you already ssh to
# (the CSV itself, or the data/input directory that contains it):
# SUGAR_REMOTE=user@host:/path/to/prediction_statistics.csv

# Or split host and path:
# SUGAR_SSH_HOST=user@host
# SUGAR_SSH_STATS=/path/to/prediction_statistics.csv

# If your ssh command uses -i, set SUGAR_SSH_IDENTITY to that same key path.
